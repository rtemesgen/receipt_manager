# Local backend environment
# Leave these defaults for local H2 development, or replace them for PostgreSQL.
DATABASE_URL=jdbc:h2:file:./data/receiptdb;AUTO_SERVER=TRUE
DATABASE_DRIVER=org.h2.Driver
DATABASE_USERNAME=sa
DATABASE_PASSWORD=
JPA_DDL_AUTO=update
H2_CONSOLE_ENABLED=true
JWT_SECRET=change-this-secret-key-to-a-long-random-value-for-production-use
JWT_EXPIRATION_MS=86400000

# Example PostgreSQL values for Render:
# DATABASE_URL=jdbc:postgresql://YOUR_RENDER_HOST:5432/YOUR_DATABASE?sslmode=require
# DATABASE_DRIVER=org.postgresql.Driver
# DATABASE_USERNAME=YOUR_RENDER_USERNAME
# DATABASE_PASSWORD=YOUR_RENDER_PASSWORD
# H2_CONSOLE_ENABLED=false

APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
